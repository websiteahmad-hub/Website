<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>items</key>
  <array>
    <dict>
      <key>assets</key>
      <array>

        <!-- 1) The signed IPA. Must be a direct HTTPS link. -->
        <dict>
          <key>kind</key><string>software-package</string>
          <key>url</key><string>https://github.com/USERNAME/REPO/releases/download/v1.0.0/SampleApp.ipa</string>
        </dict>

        <!-- 2) Optional icons (modern iOS ignores them, harmless to keep). -->
        <dict>
          <key>kind</key><string>display-image</string>
          <key>url</key><string>https://USERNAME.github.io/REPO/icons/sample.png</string>
        </dict>
        <dict>
          <key>kind</key><string>full-size-image</string>
          <key>url</key><string>https://USERNAME.github.io/REPO/icons/sample.png</string>
        </dict>

      </array>

      <key>metadata</key>
      <dict>
        <!-- Must exactly match the app's CFBundleIdentifier. -->
        <key>bundle-identifier</key><string>com.example.sampleapp</string>
        <!-- Must match CFBundleShortVersionString. -->
        <key>bundle-version</key><string>1.0.0</string>
        <key>kind</key><string>software</string>
        <!-- Name shown in the install prompt. -->
        <key>title</key><string>Sample App</string>
      </dict>
    </dict>
  </array>
</dict>
</plist>
